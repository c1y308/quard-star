# =============================================================================
# quard-star 项目 .gitignore (策略 C1: 内联跟踪 vendored 上游源码, 但排除构建产物)
# 关键: 不使用全局 *.bin / *.dtb / *.o 规则, 以免误伤 qemu 源码里合法的
#       pc-bios/*.bin (145个) 与 *.dtb 等固件/资源文件。一律用"目录级"忽略。
# =============================================================================

# ===== 构建产物目录(整体忽略) =====
/output/
/qemu-11.1.1/build/
/opensbi-1.2/build/
/trusted_domain/build/
/test/uart/build/

# ===== 日志 =====
*.log

# ===== os/ 在源码树内编译, 单独忽略其产物(限定 /os/ 路径, 保护其它 vendored 源码) =====
/os/*.o
/os/*.elf
/os/*.map
/os/*.bin
/os/*.lst
/os/build.out

# os/user 的 objdump 反汇编产物(time.txt/write.txt/xec.txt 等), 非源码
/os/user/*.txt
